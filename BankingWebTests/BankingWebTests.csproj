    <PackageReference Include="Selenium.WebDriver" Version="4.49.0" />
    <PackageReference Include="Selenium.Support" Version="4.49.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="reqnroll.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
